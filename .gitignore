# ============================================================================
#  Rocky Kombat - Unreal Engine .gitignore
#  Rule of thumb: anything the engine or the build script can regenerate is
#  excluded. Anything a human authored (Content, Config, Source, docs, the art
#  and audio pipeline inputs) is kept.
# ============================================================================

# --- Build output, caches, derived data across all platforms -----------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Packaged/
Build/Receipts/
Build/Android/*.apk
Build/Android/*.aab
Build/Android/gradle/
Build/Android/src/
Build/Android/*.gradle
.gradle/

# Keep Android build inputs, but never commit signing identities.
Build/*
!Build/Android/
Build/Android/*

# --- Local distribution artefacts (regenerable, and far too large) -----------
Dist/
RockyKombat-Dist-Checkpoint-*/
dist/

# --- Tooling downloaded per-machine -----------------------------------------
/Tools/jdk/
/Tools/Android/gradle-user-home/

# --- Secrets: signing material, tokens, credentials. NEVER commit. ----------
.secrets/
*.keystore
*.jks
*.p12
*.pem
*.key
keystore.pw
signing.env
.env
.env.*

# --- IDE / editor noise ------------------------------------------------------
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace
UE4.sln
.ignore

# --- OS noise ----------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# --- Logs, dumps, captures ---------------------------------------------------
*.log
!docs/**/*.log
*.dmp
CrashReportClient/
*.mp4
*.mkv
Saved/Evidence/

# --- Temporary / scratch -----------------------------------------------------
*.tmp
*.bak
*.orig
/tmp/
*.zip
!docs/assets/*.zip
